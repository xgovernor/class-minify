{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ComonJS",
        "lib": ["ES2020"],
        "outDir": "dist",
        "rootDir": ".",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true
    },
    "exclude": ["node_modules", "dist", "**/*.ts"]
}
